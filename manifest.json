{
    "manifest_version": 4,
    "type": "extension",
    "name": "防撤回",
    "slug": "anti_recall",
    "description": "防止QQNT撤回消息，支持文本/表情/图片/语音/视频/文件等12种消息类型，高性能零阻塞",
    "version": "0.9.3",
    "icon": "./icon.png",
    "authors": [
        {
            "name": "CDEDEFG",
            "link": "https://github.com/CDEDEFG"
        },
        {
            "name": "XiaoHe321",
            "link": "https://github.com/xh321"
        }
    ],
    "repository": {
        "repo": "CDEDEFG/LiteLoaderQQNT-Anti-Recall",
        "branch": "master",
        "release": {
            "tag": "0.6.6",
            "file": "qq-anti-recall-0.6.6.zip"
        }
    },
    "platform": ["win32", "darwin", "linux"],
    "injects": {
        "main": "./main.js",
        "preload": "./preload.js",
        "renderer": "./renderer.js"
